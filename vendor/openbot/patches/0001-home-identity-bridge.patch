+++ b/server/src/home-bridge.ts
@@ -0,0 +1,239 @@
+/**
+ * Me home identity bridge (patched seam, reviewed).
+ *
+ * The Me home server authenticates paired phones with opaque ht1_* tokens
+ * and maps each owner 1:1 to an upstream user server-side. It forwards
+ * native REST calls to this private listener with a short-lived,
+ * single-use HMAC assertion in `x-me-home-assertion`, keyed by
+ * ME_HOME_BRIDGE_SECRET (server-side only, never sent to phones, never a
+ * BetterAuth cookie, never a shared admin credential).
+ *
+ * Assertion wire format (v2):
+ *   `v2.{userId}.{expMs}.{role}.{nonceHex}.{mac}`
+ * where mac is the hex HMAC-SHA256 of the dot-joined first five fields
+ * under the bridge key. userId matches upstream person/bot id rules
+ * ([A-Za-z0-9][A-Za-z0-9_-]*, <=64); role is `admin` or `user`; expMs is a
+ * 60s-bounded unix-millis expiry; nonceHex is 128-bit random per request
+ * and is accepted exactly once (replay refused via a bounded in-memory
+ * seen-cache swept on expiry).
+ *
+ * Same-request re-reads: native `request-actor` (`identifyUser` +
+ * `identifyActor`) and `guards` may read the SAME HTTP request multiple
+ * times. The wrapper memoizes the verified identity PER ACTUAL REQUEST
+ * HEADERS OBJECT (WeakMap) bound to the assertion value, so re-reading
+ * auth within the same Request succeeds without re-consuming the
+ * single-use nonce. A NEW Request / new Headers object reusing an
+ * assertion replays the nonce and is refused. Mutated headers invalidate
+ * the cache and refuse (never fall through to cookies).
+ *
+ * No BetterAuth rows are created on this path: verification returns an
+ * ephemeral session object (a virtual trusted principal, like an
+ * Entra-verified actor), so the home-mapped user needs no password, no
+ * OAuth account and no sign-in row. Roles travel inside the signed
+ * assertion per request, so an operator role change applies on the next
+ * call with no restart and no cache to invalidate: guards.ts honours
+ * session.user.role without a DB role lookup, and no promotion hooks run.
+ *
+ * Active only when the key is configured (>=32 chars). Without it every
+ * function below is pure delegation / null, so an unconfigured deployment
+ * behaves exactly as upstream.
+ */
+import { createHmac, timingSafeEqual } from "node:crypto";
+import type { AuthService } from "./auth/guards";
+
+export const HOME_ASSERTION_HEADER = "x-me-home-assertion";
+export const HOME_ASSERTION_TTL_MS = 60_000;
+const HOME_ASSERTION_VERSION = "v2";
+const HOME_ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]*$/;
+const HOME_MAX_ID = 64;
+const HOME_NONCE_HEX_LEN = 32;
+const HOME_MAX_SEEN = 10_000;
+
+export type HomeBridgeSession = {
+  user: {
+    id: string;
+    email: string;
+    name: string;
+    role: "admin" | "user";
+  };
+};
+
+/** NonceHex -> expiryMs. Each nonce is accepted exactly once per TTL window. */
+const seenNonces = new Map<string, number>();
+
+function sweepSeenNonces(now: number): void {
+  if (seenNonces.size === 0) return;
+  for (const [nonce, exp] of seenNonces) {
+    if (exp <= now) seenNonces.delete(nonce);
+  }
+  while (seenNonces.size > HOME_MAX_SEEN) {
+    const oldest = seenNonces.keys().next();
+    if (oldest.done) break;
+    seenNonces.delete(oldest.value);
+  }
+}
+
+function bridgeKey(getKey: () => string | undefined): Buffer | null {
+  const raw = getKey()?.trim() ?? "";
+  // Fail closed: short/empty keys leave the bridge inert rather than weak.
+  if (raw.length < 32) return null;
+  return Buffer.from(raw, "utf8");
+}
+
+/**
+ * Verify an assertion value. Returns the mapped principal or null.
+ * Null covers every refusal: absent, malformed, expired, wrong role
+ * charset, bad MAC, replayed nonce, or bridge unconfigured. No throws for
+ * untrusted input.
+ *
+ * Single-use is enforced here on every call: the same assertion value
+ * verified twice (two different Headers objects) refuses the second time.
+ * Same-request re-reads must go through the wrapper cache below, never by
+ * calling this twice with the same value.
+ */
+export function verifyHomeAssertion(
+  value: string | null | undefined,
+  getKey: () => string | undefined,
+  now = Date.now(),
+): HomeBridgeSession | null {
+  try {
+    if (typeof value !== "string") return null;
+    const parts = value.split(".");
+    if (parts.length !== 6) return null;
+    const [version, userId, expRaw, role, nonceHex, mac] = parts;
+    if (version !== HOME_ASSERTION_VERSION) return null;
+    if (
+      !userId ||
+      userId.length > HOME_MAX_ID ||
+      !HOME_ID_RE.test(userId)
+    )
+      return null;
+    if (role !== "admin" && role !== "user") return null;
+    if (!/^[0-9a-f]{32}$/.test(nonceHex ?? "")) return null;
+    const exp = Number(expRaw);
+    if (!Number.isFinite(exp) || exp <= now) return null;
+    const key = bridgeKey(getKey);
+    if (!key) return null;
+    const payload = `${version}.${userId}.${expRaw}.${role}.${nonceHex}`;
+    const expected = createHmac("sha256", key).update(payload).digest();
+    let actual: Buffer;
+    try {
+      actual = Buffer.from(mac, "hex");
+    } catch {
+      return null;
+    }
+    if (actual.length !== expected.length) return null;
+    if (!timingSafeEqual(actual, expected)) return null;
+    sweepSeenNonces(now);
+    if (seenNonces.has(nonceHex)) return null;
+    seenNonces.set(nonceHex, exp);
+    // Display/audit identity only. Authorization uses id + signed role:
+    // guards.ts takes session.user.role verbatim, so no DB role lookup
+    // (and no promotion hook) runs on this path. No user/session rows are
+    // created: the principal is virtual and ephemeral per request.
+    return {
+      user: {
+        id: userId,
+        email: `${userId}@me.home`,
+        name: userId,
+        role,
+      },
+    };
+  } catch {
+    return null;
+  }
+}
+
+/** Interactive auth surface when no OAuth provider is configured. */
+function bridgeOnlyHandler(): Response {
+  return new Response(
+    JSON.stringify({
+      error:
+        "Interactive sign-in is not configured on this deployment. Use the paired home app.",
+    }),
+    {
+      status: 404,
+      headers: {
+        "content-type": "application/json",
+        "cache-control": "no-store",
+      },
+    },
+  );
+}
+
+type CachedBridge = { assertion: string; session: HomeBridgeSession | null };
+
+/**
+ * Per-request memo: Headers object -> { assertion, session }.
+ * Bound to the exact assertion value; any header mutation invalidates.
+ * WeakMap so entries die with the request; no cross-request replay window.
+ */
+const bridgeSessionCache = new WeakMap<Headers, CachedBridge>();
+
+function verifyAndCache(
+  header: string,
+  headers: Headers,
+  getKey: () => string | undefined,
+): HomeBridgeSession | null {
+  const cached = bridgeSessionCache.get(headers);
+  if (cached && cached.assertion === header) return cached.session;
+  if (cached) bridgeSessionCache.delete(headers);
+  const verified = verifyHomeAssertion(header, getKey);
+  bridgeSessionCache.set(headers, { assertion: header, session: verified });
+  return verified;
+}
+
+/**
+ * Wrap an AuthService so the home assertion is honoured on every guard.
+ * No assertion header -> delegate to the wrapped service unchanged, unless
+ * this same Headers object previously carried a bridge assertion and was
+ * mutated to strip it (then refuse, never fall back to cookies).
+ * Invalid assertion -> null (refuse; never fall through to cookies).
+ * Same Headers object + same assertion -> cached session (no nonce
+ * re-consumption, so identifyUser + identifyActor + guards on one Request
+ * all see the same verified owner). Different Headers object reusing an
+ * assertion -> replay refused via the single-use nonce cache.
+ * No wrapped service (bridge-only deployment: paired phones without a
+ * separate Google/Entra/Okta app) -> a minimal AuthService whose handler
+ * declines interactive sign-in and whose getSession honours only the
+ * bridge. With no bridge key configured the bridge path always refuses.
+ */
+export function wrapAuthWithHomeBridge(
+  auth: AuthService | undefined,
+  options: { getKey: () => string | undefined },
+): AuthService {
+  const bridgeOnly: AuthService["api"]["getSession"] = async (input) => {
+    const header = input.headers.get(HOME_ASSERTION_HEADER);
+    if (header === null) {
+      // Mutated strip on the same Headers object: refuse, never branch.
+      if (bridgeSessionCache.get(input.headers)) return null;
+      return null;
+    }
+    // Present means home spoke: verify strictly, refuse on failure.
+    return verifyAndCache(header, input.headers, options.getKey);
+  };
+  if (!auth) {
+    return {
+      handler: () => bridgeOnlyHandler(),
+      api: { getSession: bridgeOnly },
+    };
+  }
+  const inner = auth.api.getSession.bind(auth.api);
+  return {
+    ...auth,
+    api: {
+      ...auth.api,
+      getSession: async (input) => {
+        const header = input.headers.get(HOME_ASSERTION_HEADER);
+        if (header !== null) {
+          // Present means home spoke: verify strictly, refuse on failure.
+          return verifyAndCache(header, input.headers, options.getKey);
+        }
+        // Same Headers object previously held a bridge assertion but the
+        // header is now gone: mutated headers invalidate and refuse.
+        if (bridgeSessionCache.get(input.headers)) return null;
+        return inner(input);
+      },
+    },
+  };
+}
