{
  "name": "@mehomeai/infra-server",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "test:home": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "test:r2": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test test/home-r2.test.mjs",
    "start:home": "node --experimental-transform-types src/cli.mjs start",
    "test:spike": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test spikes/openmuse/*.test.mjs",
    "demo:spike": "node --experimental-transform-types --disable-warning=ExperimentalWarning spikes/openmuse/demo.mjs",
    "check:upstream": "python3 scripts/upstream.py verify"
  }
}
